FROM node:24.18.1-alpine@sha256:f70403e87646dc51b45295f4b8b70cdad0b63d2297c4c9899119b03f7af7a6b3 AS dependencies
WORKDIR /workspace/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

FROM dependencies AS development
COPY frontend/ ./
EXPOSE 5173
CMD ["npm", "run", "dev"]

FROM dependencies AS build
COPY frontend/ ./
RUN npm run build

FROM node:24.18.1-alpine@sha256:f70403e87646dc51b45295f4b8b70cdad0b63d2297c4c9899119b03f7af7a6b3 AS runtime
WORKDIR /app
RUN rm -rf /usr/local/lib/node_modules /opt/yarn-v1.22.22 \
    && rm -f /usr/local/bin/corepack /usr/local/bin/npm /usr/local/bin/npx \
        /usr/local/bin/yarn /usr/local/bin/yarnpkg
COPY --from=build --chown=node:node /workspace/frontend/dist ./dist
COPY --chown=node:node frontend/scripts/serve-dist.mjs ./scripts/serve-dist.mjs
EXPOSE 5173
USER node
CMD ["node", "scripts/serve-dist.mjs"]
