FROM python:3.11-slim@sha256:db3ff2e1800a8581e2c48a27c3995339d47bdf046da21c7627accd3d51053a93 AS base

ENV PYTHONUNBUFFERED=1 \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PATH="/opt/venv/bin:$PATH" \
    PYTHONPATH=/workspace/backend \
    SOURCE_DATE_EPOCH=1767225600 \
    HOME=/tmp/nora \
    XDG_CACHE_HOME=/tmp/nora/.cache \
    PYTHONPYCACHEPREFIX=/tmp/nora/pycache

COPY --from=ghcr.io/astral-sh/uv:0.11.3@sha256:90bbb3c16635e9627f49eec6539f956d70746c409209041800a0280b93152823 /uv /uvx /bin/

WORKDIR /workspace/backend
RUN apt-get update \
    && apt-get install --no-install-recommends -y \
        fonts-noto-cjk=1:20240730+repack1-1 \
        libpango-1.0-0=1.56.3-1 \
        libpangoft2-1.0-0=1.56.3-1 \
    && rm -rf /var/lib/apt/lists/*

COPY backend/pyproject.toml backend/uv.lock backend/README.md backend/LICENSE ./
COPY backend/app ./app
COPY backend/scripts ./scripts

FROM base AS development
RUN uv sync --frozen --extra dev

COPY backend/alembic.ini ./
COPY backend/alembic ./alembic
COPY backend/tests ./tests

EXPOSE 8000
CMD ["uvicorn", "app.apps.api:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000"]

FROM base AS runtime
RUN uv sync --frozen --no-dev \
    && /usr/local/bin/python -m pip uninstall --yes pip setuptools wheel \
    && rm -f /bin/uv /bin/uvx \
    && rm -rf /tmp/nora/.cache

COPY backend/alembic.ini ./
COPY backend/alembic ./alembic

RUN groupadd --gid 10001 nora \
    && useradd --uid 10001 --gid 10001 --no-create-home --home-dir /tmp/nora nora \
    && mkdir -p /tmp/nora \
    && chown -R nora:nora /tmp/nora /workspace/backend

EXPOSE 8000
USER 10001:10001
CMD ["uvicorn", "app.apps.api:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000"]
