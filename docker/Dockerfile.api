FROM python:3.11-slim@sha256:db3ff2e1800a8581e2c48a27c3995339d47bdf046da21c7627accd3d51053a93 AS base

ENV PYTHONUNBUFFERED=1 \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PATH="/opt/venv/bin:$PATH" \
    PYTHONPATH=/workspace/backend

COPY --from=ghcr.io/astral-sh/uv:0.11.3@sha256:90bbb3c16635e9627f49eec6539f956d70746c409209041800a0280b93152823 /uv /uvx /bin/

WORKDIR /workspace/backend
COPY backend/pyproject.toml backend/uv.lock backend/README.md backend/LICENSE ./
COPY backend/app ./app

FROM base AS development
RUN uv sync --frozen --extra dev

COPY backend/alembic.ini ./
COPY backend/alembic ./alembic
COPY backend/tests ./tests

EXPOSE 8000
CMD ["uvicorn", "app.apps.api:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000"]

FROM base AS runtime
RUN uv sync --frozen --no-dev

COPY backend/alembic.ini ./
COPY backend/alembic ./alembic

EXPOSE 8000
CMD ["uvicorn", "app.apps.api:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000"]
