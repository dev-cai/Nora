#!/usr/bin/env sh
set -eu

repository_root=$(git rev-parse --show-toplevel)
cd "$repository_root"

echo "Running Nora pre-commit checks in the tools container..."
docker compose run --rm --no-deps tools sh -c '
  ruff format --check . &&
  ruff check . &&
  mypy app/ &&
  pytest tests/unit tests/architecture -q
'
