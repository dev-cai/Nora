#!/usr/bin/env sh
set -eu

repository_root=$(git rev-parse --show-toplevel)
cd "$repository_root"

echo "Running Nora pre-commit checks on the host development environment..."
cd "$repository_root/backend"
uv run ruff format --check .
uv run ruff check .
uv run mypy app/
uv run pytest tests/unit tests/architecture -q
