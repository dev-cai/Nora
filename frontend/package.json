{
  "name": "nora-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "api:generate": "uv run --project ../backend python ../backend/scripts/export_openapi.py && openapi-typescript src/api/generated/openapi.json -o src/api/generated/schema.d.ts",
    "api:check": "npm run api:generate && node scripts/check-api-drift.mjs",
    "lint": "eslint .",
    "typecheck": "vue-tsc -b --pretty false",
    "test": "vitest run",
    "integration:smoke": "node ../scripts/web-api-smoke.mjs"
  },
  "dependencies": {
    "lucide-vue-next": "^0.468.0",
    "openapi-fetch": "0.17.0",
    "pinia": "^3.0.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/eslint-config-typescript": "^14.0.0",
    "@vue/test-utils": "^2.4.0",
    "eslint": "^9.0.0",
    "eslint-plugin-vue": "^10.0.0",
    "jsdom": "^26.0.0",
    "openapi-typescript": "7.13.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0",
    "vue-tsc": "^3.0.0"
  }
}
