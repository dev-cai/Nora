{
  "schema_version": "nora-rag-eval-v1",
  "dataset_version": "2026-08-20",
  "license": "synthetic",
  "description": "Synthetic Nora job-search retrieval questions; no personal or licensed source data.",
  "embedding": {
    "model": "nora-deterministic",
    "version": "sha256-v1",
    "dimension": 64
  },
  "parameters": {
    "ks": [1, 3, 5],
    "unknown_score_threshold": 0.35,
    "lexical_tokenizer": "lowercase alphanumeric and CJK runs",
    "decision_rule": "vector-only if Hit@5 >= 0.80 and unknown false-positive rate <= 0.10; otherwise hybrid if lexical is complementary; reranker is out of scope"
  },
  "chunks": [
    {"id": "src-python-v1-0", "owner": "owner-a", "source_id": "source-python", "source_version": 1, "ordinal": 0, "deleted": false, "text": "Python 后端服务使用 FastAPI，异步数据库访问通过 SQLAlchemy 2。"},
    {"id": "src-postgres-v1-0", "owner": "owner-a", "source_id": "source-postgres", "source_version": 1, "ordinal": 0, "deleted": false, "text": "PostgreSQL 保存业务事实，Alembic 管理数据库迁移。"},
    {"id": "src-vue-v1-0", "owner": "owner-a", "source_id": "source-vue", "source_version": 1, "ordinal": 0, "deleted": false, "text": "前端使用 Vue 3、TypeScript 和 Pinia，页面通过 HTTP API 恢复状态。"},
    {"id": "src-rag-v1-0", "owner": "owner-a", "source_id": "source-rag", "source_version": 1, "ordinal": 0, "deleted": false, "text": "最小 RAG 链路是 Source、Chunk、Embedding、exact cosine 检索和 Citation。"},
    {"id": "src-rag-v1-1", "owner": "owner-a", "source_id": "source-rag", "source_version": 1, "ordinal": 1, "deleted": false, "text": "没有足够 Evidence 时，知识问答必须返回 unknown，而不是猜测答案。"},
    {"id": "src-owner-v1-0", "owner": "owner-a", "source_id": "source-owner", "source_version": 1, "ordinal": 0, "deleted": false, "text": "检索先过滤 owner、Source 版本和已删除 Artifact，避免跨用户泄露。"},
    {"id": "src-artifact-v1-0", "owner": "owner-a", "source_id": "source-artifact", "source_version": 1, "ordinal": 0, "deleted": false, "text": "Artifact 是不可变版本，删除后其派生 Chunk 不再产生新的检索结果。"},
    {"id": "src-embedding-v1-0", "owner": "owner-a", "source_id": "source-embedding", "source_version": 1, "ordinal": 0, "deleted": false, "text": "Embedding 记录包含 model、version 和 dimension，向量可从 Source 重建。"},
    {"id": "src-interview-v1-0", "owner": "owner-a", "source_id": "source-interview", "source_version": 1, "ordinal": 0, "deleted": false, "text": "面试准备分为项目深挖、技术栈与基础、简历风险与反问三个受控主题。"},
    {"id": "src-decision-v1-0", "owner": "owner-a", "source_id": "source-decision", "source_version": 1, "ordinal": 0, "deleted": false, "text": "投递决定只记录用户确认的 apply 或 skip 意图，不执行外部写。"},
    {"id": "src-jobfit-v1-0", "owner": "owner-a", "source_id": "source-jobfit", "source_version": 1, "ordinal": 0, "deleted": false, "text": "JobFitAnalysis 固定岗位、主档、简历和 DecisionCase 的精确版本。"},
    {"id": "src-model-v1-0", "owner": "owner-a", "source_id": "source-model", "source_version": 1, "ordinal": 0, "deleted": false, "text": "ModelPort 失败、超时或输出无效时，AI 能力稳定失败且不写入业务事实。"},
    {"id": "src-security-v1-0", "owner": "owner-a", "source_id": "source-security", "source_version": 1, "ordinal": 0, "deleted": false, "text": "外部写默认关闭，不保存密钥、Cookie、个人简历或模型私有思维链。"},
    {"id": "src-ci-v1-0", "owner": "owner-a", "source_id": "source-ci", "source_version": 1, "ordinal": 0, "deleted": false, "text": "CI 执行后端质量、前端类型测试构建、容器、文档和浏览器门禁。"},
    {"id": "src-architecture-v1-0", "owner": "owner-a", "source_id": "source-architecture", "source_version": 1, "ordinal": 0, "deleted": false, "text": "Domain 不得导入 FastAPI、SQLAlchemy、LangGraph 或 Provider SDK。"},
    {"id": "src-version-v1-0", "owner": "owner-a", "source_id": "source-version", "source_version": 1, "ordinal": 0, "deleted": false, "text": "刷新面试准备会追加新版本，历史版本仍可按精确 version 读取。"},
    {"id": "src-unknown-v1-0", "owner": "owner-a", "source_id": "source-unknown", "source_version": 1, "ordinal": 0, "deleted": false, "text": "无证据的准备主题显示 unknown，并提供不带事实断言的通用建议。"},
    {"id": "src-lifecycle-v1-0", "owner": "owner-a", "source_id": "source-lifecycle", "source_version": 1, "ordinal": 0, "deleted": false, "text": "Issue、分支和 PR 遵循一 Issue、一分支、一 PR，合并后再开始下一项。"},
    {"id": "src-go-v1-0", "owner": "owner-b", "source_id": "source-go", "source_version": 1, "ordinal": 0, "deleted": false, "text": "Go 服务使用 Gin 和 PostgreSQL，这是另一位用户的私有来源。"},
    {"id": "src-deleted-v1-0", "owner": "owner-a", "source_id": "source-deleted", "source_version": 1, "ordinal": 0, "deleted": true, "text": "已删除来源中的旧 Redis 集群配置不应被检索。"},
    {"id": "src-old-version-v1-0", "owner": "owner-a", "source_id": "source-versioned", "source_version": 1, "ordinal": 0, "deleted": false, "text": "旧版本使用 Milvus；当前版本使用 PostgreSQL exact cosine。"},
    {"id": "src-versioned-v2-0", "owner": "owner-a", "source_id": "source-versioned", "source_version": 2, "ordinal": 0, "deleted": false, "text": "当前版本使用 PostgreSQL exact cosine，Milvus 只有达到触发条件后才评估。"},
    {"id": "src-cost-v1-0", "owner": "owner-a", "source_id": "source-cost", "source_version": 1, "ordinal": 0, "deleted": false, "text": "评测记录检索延迟和成本假设，但不建设在线 benchmark 平台。"},
    {"id": "src-groundtruth-v1-0", "owner": "owner-a", "source_id": "source-groundtruth", "source_version": 1, "ordinal": 0, "deleted": false, "text": "Ground Truth 在调参前冻结，失败样例必须保留，不能修改事实迎合实现。"}
