ENV=dev
DEBUG=true
LOG_LEVEL=DEBUG
DATABASE_URL=postgresql+asyncpg://nora:change-me-local@localhost:5432/nora
API_PORT=8000
WEB_PORT=5173
AUTH_SECRET_KEY=development-only-change-this-secret
AUTH_ACCESS_TOKEN_MINUTES=30
# 百度智能云 OCR（应用：简历识别、JD 信息识别）
BAIDU_OCR_API_KEY=
BAIDU_OCR_SECRET_KEY=
BAIDU_OCR_ENDPOINT=accurate_basic
# DeepSeek OpenAI-compatible Chat；默认留空，不影响未配置模型的确定性流程
DEEPSEEK_API_KEY=
DEEPSEEK_API_KEY_FILE=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-v4-flash
DEEPSEEK_CHAT_TIMEOUT_SECONDS=60
POSTGRES_USER=nora
POSTGRES_PASSWORD=change-me-local
POSTGRES_DB=nora
POSTGRES_PORT=5432
STORAGE_PORT=9000
STORAGE_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
ARTIFACT_STORAGE_ENDPOINT=localhost:9000
ARTIFACT_STORAGE_ACCESS_KEY=nora-app
ARTIFACT_STORAGE_SECRET_KEY=development-artifact-secret
ARTIFACT_BACKUP_ACCESS_KEY=nora-backup
ARTIFACT_BACKUP_SECRET_KEY=development-backup-secret
ARTIFACT_STORAGE_BUCKET=nora-artifacts
ARTIFACT_STORAGE_SECURE=false
MINIO_ROOT_PASSWORD=change-me-local
